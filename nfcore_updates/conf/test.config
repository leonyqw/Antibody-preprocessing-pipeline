/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run abprep -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    read_dir            = "${projectDir}/test_data"
    sample_sheet        = "/vast/projects/antibody_sequencing/preprocessing_pipeline/data/reference_files/sample_sheet.csv"
    phagemid_ref        = "/vast/projects/antibody_sequencing/preprocessing_pipeline/data/reference_files/fab_phagemid.fa"
    matchbox_script     = "/vast/projects/antibody_sequencing/preprocessing_pipeline/bin/matchbox_preprocessing_script.mb"
    matchbox_parameters = "/vast/projects/antibody_sequencing/preprocessing_pipeline/data/reference_files/matchbox_parameters.csv"
    output_dir          = "results"
    help                = false
    enable_conda        = false
    nanobody            = false

}